{
  "name": "rummal",
  "version": "0.1.0",
  "private": true,
  "description": "Hittumst — an Iceland-first LGBTQ+ social and dating app",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "decode-uri-component": "0.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "dev:mobile": "npm run start --workspace @rummal/mobile",
    "dev:admin": "npm run dev --workspace @rummal/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings 0",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run test:release && npm run test:dependencies && npm run lint",
    "postinstall": "patch-package --error-on-fail && node --test scripts/dependency-security.test.mjs",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:local": "node scripts/db-local-test.mjs",
    "test:release": "node --test scripts/release-policy.test.mjs",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "pg": "^8.23.0",
    "prettier": "3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "decode-uri-component": "0.5.0",
    "patch-package": "8.0.1"
  }
}
