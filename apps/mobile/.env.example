# Keep service-role and secret keys out of the mobile app. Use a publishable key only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_APP_ENV=development
# Development only: use seeded data and open the main app without authentication.
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_WEBSITE_URL=
# Hittingar remains off unless both flags are true in production.
EXPO_PUBLIC_HITTINGAR_ENABLED=false
EXPO_PUBLIC_HITTINGAR_PRODUCTION_GATES_PASSED=false

# Native RevenueCat: store for App Store/Google Play, test-store only on isolated nonproduction builds.
# PUBLIC SDK keys only. Private provider credentials belong on the server.
EXPO_PUBLIC_REVENUECAT_MODE=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_SANDBOX_KEY=
EXPO_PUBLIC_REVENUECAT_PLUS_PACKAGE=
EXPO_PUBLIC_REVENUECAT_PREMIUM_PACKAGE=

# Restricted native map key; coordinate/geocoder terms must be accepted.
EXPO_PUBLIC_MAPTILER_KEY=

# Native stores (public SDK keys, never RevenueCat secret keys).
# Use test-store only outside production; store mode still needs server purchase authorization.
EXPO_PUBLIC_REVENUECAT_MODE=test-store
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional minimal JavaScript crash reporting. Demo builds never send reports.
# Native crash/ANR transport is disabled until separately privacy-reviewed and verified.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_PRIVACY_VERIFIED=false
# Separate native opt-in: leave false until the signed-device/intercepted-network matrix in docs/native-diagnostics.md passes.
EXPO_PUBLIC_SENTRY_NATIVE_PRIVACY_VERIFIED=false
EXPO_PUBLIC_RELEASE_ID=
