# Keep service-role and secret keys out of the mobile app. Use a publishable key only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_APP_ENV=development
# Development only: use seeded data and open the main app without authentication.
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_WEBSITE_URL=
# Hittingar remains off unless both flags are true in production.
EXPO_PUBLIC_HITTINGAR_ENABLED=false
EXPO_PUBLIC_HITTINGAR_PRODUCTION_GATES_PASSED=false
