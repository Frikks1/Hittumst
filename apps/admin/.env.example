# Hittumst admin uses a publishable key and the signed-in admin's JWT.
# Moderation requests use the staff session and never the worker's secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only background worker settings. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Optional. When true, demo data is used even when Supabase is configured.
NEXT_PUBLIC_RUMMAL_DEMO_MODE=false

# Public website. Keep both flags false until the corresponding release evidence passes.
HITTUMST_POLICIES_APPROVED=false
HITTUMST_PUBLIC_RELEASE=false
HITTUMST_OPERATOR_NAME=
HITTUMST_OPERATOR_ADDRESS=
HITTUMST_CHILD_SAFETY_EMAIL=
HITTUMST_POLICY_DATE=
HITTUMST_SUPPORT_COVERAGE_IS=
HITTUMST_SUPPORT_COVERAGE_EN=
HITTUMST_RETENTION_NOTICE_IS=
HITTUMST_RETENTION_NOTICE_EN=
HITTUMST_TRANSFER_NOTICE_IS=
HITTUMST_TRANSFER_NOTICE_EN=
HITTUMST_IOS_STORE_URL=
HITTUMST_ANDROID_STORE_URL=
