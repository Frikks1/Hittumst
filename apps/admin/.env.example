# Hittumst admin uses a publishable key and the signed-in admin's JWT.
# Moderation requests use the staff session and never the worker's secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only background worker settings. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Required for the authenticated /api/operations/health deployment identity.
HITTUMST_APP_ENV=development
CRON_SECRET=

# Optional. When true, demo data is used even when Supabase is configured.
NEXT_PUBLIC_RUMMAL_DEMO_MODE=false

# Public website. Keep both flags false until the corresponding release evidence passes.
HITTUMST_POLICIES_APPROVED=false
HITTUMST_PUBLIC_RELEASE=false
HITTUMST_OPERATOR_NAME=
HITTUMST_OPERATOR_ADDRESS=
HITTUMST_CHILD_SAFETY_EMAIL=
HITTUMST_POLICY_DATE=
HITTUMST_SUPPORT_COVERAGE_IS=
HITTUMST_SUPPORT_COVERAGE_EN=
HITTUMST_RETENTION_NOTICE_IS=
HITTUMST_RETENTION_NOTICE_EN=
HITTUMST_TRANSFER_NOTICE_IS=
HITTUMST_TRANSFER_NOTICE_EN=
HITTUMST_IOS_STORE_URL=
HITTUMST_ANDROID_STORE_URL=

# Money is isolated and disabled until approved provider adapters and funded reserves exist.
# Both URLs must match an isolated sandbox project; the production project is denied.
COMMERCE_MODE=disabled
COMMERCE_SANDBOX_SUPABASE_URL=
# RevenueCat server-only credentials. Separate staging and production projects; production sales stay closed.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PLUS_PRODUCT=
REVENUECAT_PREMIUM_PRODUCT=
# SANDBOX in staging/local, PRODUCTION only in production; must match private.billing_configuration.
REVENUECAT_ENVIRONMENT=
# Exact store product identifiers (package IDs are configured separately in mobile).
REVENUECAT_PLUS_PRODUCTS=
REVENUECAT_PREMIUM_PRODUCTS=
REVENUECAT_PLUS_ENTITLEMENT=
REVENUECAT_PREMIUM_ENTITLEMENT=
# V2 customer erasure and alias safety. Secret needs customer_information:customers:read_write.
REVENUECAT_PROJECT_ID=
REVENUECAT_ERASURE_KEY=

# Album processing requires an FFmpeg-capable Node worker, not an Edge runtime.
FFMPEG_PATH=
FFPROBE_PATH=
AWS_REGION=eu-central-1
AWS_MEDIA_BUCKET=
# Keep false until region, private bucket/lifecycle, AI-service opt-out and DPA are verified.
AWS_MEDIA_PRIVACY_VERIFIED=false
# Prefer a narrowly scoped workload identity; do not put AWS secrets in mobile/public envs.
# Schedule the authenticated /api/jobs/media, /api/jobs/commerce and
# /api/jobs/account-deletion routes only in the verified deployment environment.

# Exact web-app origins allowed to use authenticated account media and commerce APIs.
# Comma-separated HTTPS origins, without trailing slashes; never use '*'.
# Local HTTP origins work only with HITTUMST_APP_ENV=development.
MEMBER_WEB_ORIGINS=

# Continuous Render worker. Set role independently per service.
WORKER_SCHEDULER=render
WORKER_EXECUTION_ROLE=web
WORKER_EXPECTED_PROJECT_REF=
# Only true in an isolated staging project containing synthetic accounts.
STAGING_SYNTHETIC_DATA_CONFIRMED=false
PUSH_WORKER_SECRET=

# Group audio: server credentials only. LiveKit Cloud is required.
HITTUMST_GROUP_VOICE_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_WORKER_SECRET=

# Apple token custody and reauthorization; never public or mobile variables.
APPLE_NATIVE_CLIENT_ID=is.rummal.app
APPLE_SERVICE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 32 random bytes encoded as 64 hexadecimal characters; retain for token decryption.
APPLE_TOKEN_ENCRYPTION_KEY=

# Optional minimal server diagnostics, EU project only.
SENTRY_ENABLED=false
SENTRY_DSN=
# Trusted build only; never pass auth token as a Docker build argument.
SENTRY_UPLOAD_SOURCEMAPS=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Independent encrypted media backups and deletion journal (separate from moderation bucket).
MEDIA_BACKUP_BUCKET=
MEDIA_BACKUP_ENCRYPTION_KEY=
MEDIA_BACKUP_KEY_ID=

